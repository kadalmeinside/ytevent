<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct web access to sensitive project files and internal directories
    RewriteRule ^\.(?!well-known).* - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|node_modules|vendor)/ - [F,L]
    RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|vite\.config\.js|phpunit\.xml|\.env.*) - [F,L]

    # Forward all requests into the public/ directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
