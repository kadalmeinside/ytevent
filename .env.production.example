# ==============================================================================
# SAMPLE .ENV UNTUK PRODUCTION (CPANEL HOSTING) - YT.PERSIJADEVELOPMENT.ID
# ==============================================================================
# Salin file ini menjadi ".env" di folder root project server Anda:
# cp .env.production.example .env
# Lalu generate key dengan: php artisan key:generate
# ==============================================================================

APP_NAME="Persija Development"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://yt.persijadevelopment.id
ASSET_URL=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# LOGGING (Rotasi harian agar log tidak membebani kuota hosting)
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ==============================================================================
# DATABASE MYSQL CPANEL
# ==============================================================================
# Catatan: Di cPanel, nama database & username biasanya diawali prefix akun Anda
# Contoh: u1076606_ytevent (dibuat lewat menu cPanel "MySQL® Databases")
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u1076606_ytevent
DB_USERNAME=u1076606_ytevent
DB_PASSWORD="GANTI_DENGAN_PASSWORD_DATABASE_CPANEL_ANDA"

# ==============================================================================
# SESI & COOKIE KEAMANAN (HTTPS WAJIB)
# ==============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Jika di belakang Cloudflare / Reverse Proxy CDN, isi '*' atau IP proxy
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=persija_ytevent_

# ==============================================================================
# EMAIL SMTP TRANSAKSIONAL
# ==============================================================================
# Opsi 1: Menggunakan Webmail cPanel sendiri (misal: noreply@persijadevelopment.id)
# Opsi 2: Menggunakan layanan SMTP khusus (Brevo, Mailgun, Amazon SES, Google Workspace)
# ==============================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.persijadevelopment.id
MAIL_PORT=465
MAIL_USERNAME=noreply@persijadevelopment.id
MAIL_PASSWORD="PASSWORD_EMAIL_WEBMAIL_ANDA"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@persijadevelopment.id"
MAIL_FROM_NAME="Persija Development"

# ==============================================================================
# FRONTEND VITE
# ==============================================================================
VITE_APP_NAME="${APP_NAME}"

# ==============================================================================
# HARDENING KEAMANAN (WAJIB FALSE DI PRODUCTION!)
# ==============================================================================
SIMULATION_MODULE_ENABLED=false
PAYMENT_SANDBOX_SIMULATOR=false

# ==============================================================================
# PAYMENT GATEWAY & PEMBAYARAN RESMI
# ==============================================================================
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

MANUAL_BANK_NAME="Bank Central Asia (BCA)"
MANUAL_BANK_ACCOUNT_NUMBER="473-5499999"
MANUAL_BANK_ACCOUNT_HOLDER="PT Persija Jakarta Hebat KCP Pamulang"

