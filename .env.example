APP_NAME="Persija Development"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://example.com
ASSET_URL=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Production: gunakan MySQL/MariaDB (sqlite hanya untuk lokal/testing)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ytevent
DB_USERNAME=ytevent
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Trusted proxy (isi dengan IP reverse proxy / load balancer, atau * jika di belakang CDN tepercaya)
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Observability: aktifkan alert email setelah MAIL_* production siap.
OBSERVABILITY_SLOW_QUERIES=false
OBSERVABILITY_SLOW_QUERY_THRESHOLD_MS=500
OBSERVABILITY_ALERTS=false
OBSERVABILITY_ALERT_EMAIL=ops@example.com

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Production: wajib SMTP/SES sungguhan (bukan "log")
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# KEAMANAN: harus false di production (modul simulasi dipaksa mati saat APP_ENV=production)
SIMULATION_MODULE_ENABLED=false
PAYMENT_SANDBOX_SIMULATOR=false
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
MANUAL_BANK_NAME="Bank Central Asia (BCA)"
MANUAL_BANK_ACCOUNT_NUMBER="473-5499999"
MANUAL_BANK_ACCOUNT_HOLDER="PT Persija Jakarta Hebat KCP Pamulang"
